<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cube SMT</title>
  <meta name="google" content="notranslate">
  <link rel="shortcut icon" href="assets/favicon.webp" type="image/x-icon">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <script id="cube-template" type="text/x-handlebars-template">
    <div class="container">
      <aside class="cube">
        {{#each sides}}
          <div class="side {{this}}"></div>
        {{/each}}
      </aside>
    </div>
  </script>

  <script>
    const source = document.getElementById("cube-template").innerHTML;
    const template = Handlebars.compile(source);
    const html = template({ sides: ["front", "behind", "right", "left", "top", "bottom"] });
    document.body.innerHTML = html;
  </script>
</body>
</html>
